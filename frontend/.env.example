EXPO_PUBLIC_API_BASE_URL=http:///v1
# Change to your machine LAN IP

# Public origin of the web build, without a trailing slash.
# Used for canonical, Open Graph, Twitter, and JSON-LD URLs.
# Leave empty until the production domain is known.
EXPO_PUBLIC_SITE_URL=


# Google sign-in: public OAuth client ID for the Android app.
# Same value as the API's GOOGLE_CLIENT_ID. Leave empty to keep the button inert.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
