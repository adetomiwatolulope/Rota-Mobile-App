# API
PORT=4000
NODE_ENV=development

# PostgreSQL 16
DATABASE_URL=postgresql://rota:rota_dev_pw@localhost:5433/rota_dev?schema=public

# Redis (rate limits, locks, BullMQ)
REDIS_URL=redis://localhost:6379

# JWT - both secrets must be at least 32 characters. Access 15 minutes, refresh 30 days.
JWT_SECRET=dev_jwt_secret_change_me_32_chars_min
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_32_chars

# Email - Postmark. Empty POSTMARK_TOKEN disables sending.
EMAIL_FROM=hello@rota.example
POSTMARK_TOKEN=

# SMTP fallback for local development. Empty SMTP_HOST logs instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# SMS invites (Termii)
TERMII_API_KEY=
TERMII_SENDER_ID=Rota

# Push (Expo Push Service)
EXPO_ACCESS_TOKEN=

# Observability
SENTRY_DSN_API=
POSTHOG_API_KEY=

# Google sign-in: public OAuth client ID (same value as the mobile app's
# EXPO_PUBLIC_GOOGLE_CLIENT_ID). Empty disables the endpoint.
GOOGLE_CLIENT_ID=

# Invite deep-link base (app scheme, not a web URL)
APP_LINK_BASE_URL=rota://invite

# Billing - amounts are integer kobo. SEAT_PRICE stays 0 until V6 passes.
SEAT_PRICE=0

# Flutterwave sandbox keys. Never use live keys outside production.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_REDIRECT_URL=
BILLING_RETURN_URL=
