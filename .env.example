# Rota monorepo — names only, no values.
# Copy to .env and fill in for each environment.
# Never commit .env files.

# ── PostgreSQL ──────────────────────────────────────────────────
DATABASE_URL=

# ── Redis (Upstash or local) ────────────────────────────────────
REDIS_URL=

# ── API ─────────────────────────────────────────────────────────
PORT=
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# ── Postmark (email) ────────────────────────────────────────────
POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=

# ── Termii (SMS — invites only) ─────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=

# ── Expo Push ────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ── Sentry ───────────────────────────────────────────────────────
SENTRY_DSN_API=
SENTRY_DSN_MOBILE=

# ── PostHog (analytics) ──────────────────────────────────────────
POSTHOG_API_KEY=

# ── Flutterwave (MVP-B billing only) ────────────────────────────
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# ── Billing (MVP-B) ──────────────────────────────────────────────
# SEAT_PRICE is in kobo (integer minor units). Do not set until
# pilot data is in and the margin check (V6) passes.
SEAT_PRICE=
