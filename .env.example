# Rota monorepo — names only, no values.
# Copy to .env and fill in for each environment.
# Never commit .env files.

# ── PostgreSQL ──────────────────────────────────────────────────
DATABASE_URL=

# ── Redis (Upstash or local) ────────────────────────────────────
REDIS_URL=

# ── API ─────────────────────────────────────────────────────────
PORT=
NODE_ENV=
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Postmark (email) ────────────────────────────────────────────
# Server token for sending verification email. Empty disables sending
# (the app still works; the worker logs "email not sent").
POSTMARK_TOKEN=
EMAIL_FROM=

# ── SMTP (Nodemailer — owner override of the locked email provider) ──
# When SMTP_HOST is empty the worker logs the message instead of sending.
# Always set EMAIL_FROM to a sender your SMTP account is allowed to use.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# ── Termii (SMS — invites only) ─────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=

# ── Expo Push ────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ── Sentry ───────────────────────────────────────────────────────
SENTRY_DSN_API=
SENTRY_DSN_MOBILE=

# ── PostHog (analytics) ──────────────────────────────────────────
POSTHOG_API_KEY=

# ── Google sign-in ───────────────────────────────────────────────
# Public OAuth client ID. Empty disables POST /v1/auth/google.
GOOGLE_CLIENT_ID=

# ── Deep links ───────────────────────────────────────────────────
# Invite link base. The app scheme, not a web URL.
APP_LINK_BASE_URL=

# ── Flutterwave (MVP-B billing only) ────────────────────────────
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_REDIRECT_URL=

# ── Billing (MVP-B) ──────────────────────────────────────────────
# SEAT_PRICE is in kobo (integer minor units). Do not set until
# pilot data is in and the margin check (V6) passes.
SEAT_PRICE=
# Where the hosted billing page returns the browser after checkout.
BILLING_RETURN_URL=
